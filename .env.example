# Порт Fastify (в проде задаётся платформой)
PORT=3000

# Строка подключения PostgreSQL (Neon). Если не задана — используется PGlite (тесты/локальный dev).
# Формат: postgresql://user:password@host/db?sslmode=require
#
# SSL-режим в этой строке можно не трогать: сервер сам приводит его к
# verify-full (server/env.ts, normalizeSslMode), потому что и Neon, и Render
# формируют ссылку сами и по умолчанию кладут sslmode=require, на который
# pg-connection-string ругается предупреждением.
DATABASE_URL=

# Панель организатора (/dashboard, /admin/*) и административные API открыты
# без логина: владелец один и заранее задан, авторизация по спецификации курса
# не нужна (ADR-0028). Переменная ADMIN_PASSWORD больше не используется — если
# она осталась в окружении, сервер её игнорирует.

# ── Cloudflare Turnstile (ADR-0025) ──────────────────────────────────────
# CAPTCHA включена, когда задан TURNSTILE_SECRET_KEY. Если он пуст — виджет
# не показывается и сервер не проверяет токен (удобно для dev и CI).
# Настройка виджета: https://dash.cloudflare.com → Turnstile → Create a widget
#   Widget mode: Managed, Appearance: Visible, Pre-clearance: Off.
# На бесплатном плане 10 хостов на виджет; локально добавьте localhost.
#
# В продакшене задать в Render (Environment), НЕ в этом файле — он в git.
# Локально удобно использовать официальные тестовые ключи (не тратят лимиты):
#   TURNSTILE_SITEKEY=1x00000000000000000000AA          # always pass
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  # always pass
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# Домены через запятую, которым разрешено использовать site key.
# Пусто — сверка hostname выключена. В Render: calendar-slots-app.onrender.com
TURNSTILE_ALLOWED_HOSTNAMES=

# ── Email-уведомления (ADR-0026) ─────────────────────────────────────────
# Отправка включена, когда задан EMAIL_API_KEY (Brevo HTTP API). Если пусто —
# письма не отправляются (no-op), dev/CI/e2e не зависят от внешнего сервиса.
# Free-план Brevo: 300 писем/день, без карты. На Render SMTP заблокирован,
# поэтому используется только HTTP API.
# В продакшене задать в Render (Environment), НЕ в этом файле — он в git.
# API-ключ: Brevo → SMTP & API → API Keys.
EMAIL_API_KEY=

# Отправитель. Email обязан быть верифицирован в Brevo (Senders).
# Формат: "Календарь звонков <sender@example.com>"
EMAIL_FROM=

# Reply-To — почта организатора, на неё гость может ответить.
EMAIL_REPLY_TO=

# Получатель писем организатору (новая бронь, отмена). Пусто — организатору не шлём.
ORGANIZER_EMAIL=

# Напоминание за N минут до встречи (1440 = 24 часа).
REMINDER_LEAD_MINUTES=1440

# Секрет внешнего cron (cron-job.org) для POST /api/internal/reminders.
# Не задан — endpoint выключен. Запрос обязан прислать заголовок X-Reminders-Secret.
REMINDERS_SECRET=

# Базовый origin для абсолютных ссылок в письмах.
# Пусто — используется RENDER_EXTERNAL_URL, затем http://localhost:<PORT>.
APP_ORIGIN=
