{
  "$schema": "https://opencode.ai/config.json",

  "plugin": ["opencode-notify"],

  // Меняем дефолтную модель на DeepSeek, чтобы она стала доступна в интерфейсе
  "model": "deepseek/deepseek-v4.1-flash",

  // Исправлено: согласно схеме, ключ называется "agent" (не "agents").
  // КРИТИЧНО: все субагенты используют ТОЛЬКО бесплатные модели —
  // см. docs/model-usage.md и AGENTS.md.
  "agent": {
    "explore": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny"
      }
    },
    "general": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  },

  // Политики доступа к провайдерам (experimental.policies валиден по схеме).
  "experimental": {
    "continue_loop_on_deny": true,
    "policies": [
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "deepseek"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode"
      }
    ]
  },

  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
